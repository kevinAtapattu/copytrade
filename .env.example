# Copy to .env and fill in. .env is gitignored. Never commit real values.

# ---- Data mode ----
# snapshot (default): pay PumpPortal only for tracked wallets' own trades; read token
#   prices from the bonding curve via SOLANA_RPC_URL (free Helius tier is plenty).
# stream: also pay for every trade on every token they hold (much more expensive;
#   raise MSG_DAILY_BUDGET if you use it).
DATA_MODE=snapshot
# Requests/sec cap and daily cap for RPC (Helius free: 10/s, 1M credits/month)
RPC_RPS=8
RPC_DAILY_MAX=30000
# How often held tokens are re-priced (marks + stop-loss)
MARK_INTERVAL=30s

# Discovery in snapshot mode fetches a 5x token's earliest trades over RPC:
# up to DISCOVERY_MAX_PAGES x 1000 signatures + DISCOVERY_MAX_TX transactions per token,
# capped at DISCOVERY_RPC_DAILY_MAX calls/day.
# DISCOVERY_SEED_MIGRATIONS also scans every token that completed its curve (~15x),
# from PumpPortal's free migration stream, so discovery finds wallets with none tracked yet.
DISCOVERY_SEED_MIGRATIONS=true
DISCOVERY_MAX_PAGES=15
DISCOVERY_MAX_TX=400
DISCOVERY_RPC_DAILY_MAX=15000

# ---- Required for live data (Phase 1+) ----
# Where tracked wallets' trades come from:
#  helius     (default) Helius logsSubscribe on SOLANA_RPC_URL's key: sees trades from every trading
#             terminal, free (billed by data volume, capped below). PumpPortal then only carries the
#             free graduated-token feed, so MSG_DAILY_BUDGET doesn't apply.
#  pumpportal PumpPortal subscribeAccountTrade (metered). Misses trades placed through some terminals.
WALLET_SOURCE=helius
HELIUS_WS_DAILY_MB=300
# Per-wallet cap. Other copy bots mention popular wallets in thousands of txs a minute and
# Helius bills each one; a wallet over this moves to a low-data feed (still tracked, ~1s slower).
HELIUS_WALLET_DAILY_MB=10
# All-in fee on PumpSwap, where tokens trade after graduating (observed ~1.25%).
PUMPSWAP_FEE_PCT=1.25
# How often to check that wallets still hold their open copies' tokens (catches exits we can't see as trades). 0 = off.
EXIT_CHECK_EVERY=2m
# PumpPortal API key. Account/token trade streams are metered: 0.01 SOL per 10k messages.
# The wallet linked to the key needs >= 0.02 SOL.
PUMPPORTAL_API_KEY=
# Spending guard. 10,000 messages = 0.01 SOL. When the daily budget is hit, all
# subscriptions pause until midnight UTC. A wallet over the hourly limit is dropped.
MSG_DAILY_BUDGET=1000
# A wallet with more trades than this in one UTC day is paused (kept on the dashboard, not tracked)
# until the next UTC midnight (8pm Eastern), then resumes on its own.
WALLET_MAX_TRADES_PER_DAY=1000

# ---- Infra (defaults work with `make dev-deps`; compose overrides these inside containers) ----
DATABASE_URL=postgres://copytrade:copytrade@localhost:5432/copytrade?sslmode=disable
REDIS_URL=redis://localhost:6379
WALLETS_FILE=wallets.txt

# ---- Simulation ----
COPY_SIZE_USD=25
PUMP_FEE_PCT=1.25
# Paper copies always pay PumpPortal's trade fee (PUMPPORTAL_LOCAL_FEE_PCT, what live trading costs).
# Set BOT_FEE_ENABLED=true to model a different bot's fee instead.
BOT_FEE_ENABLED=false
BOT_FEE_PCT=1.0
PRIORITY_FEE_SOL=0.0005
# Used if live SOL/USD price fetch fails
SOL_USD_FALLBACK=150

# ---- Scoring / rotation ----
LIVE_MAX=3
BENCH_MAX=50
ROTATION_DELAY_S=2
BANKROLL_USD=500
MAX_DRAWDOWN=0.25

# ---- Executor (Phase 4). PAPER mode unless LIVE_TRADING=true ----
LIVE_TRADING=false
# base58 secret key of a SMALL hot wallet. Never commit.
TRADER_PRIVATE_KEY=
# Helius RPC URL (free tier works): https://mainnet.helius-rpc.com/?api-key=...
# Used for price reads in snapshot mode, and for sending txs when live.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
EXEC_SIZE_USD=25
EXEC_SLIPPAGE_PCT=15
EXEC_PRIORITY_FEE_SOL=0.0005
# >0 sends through Jito as a bundle; the tip replaces the priority fee
JITO_TIP_SOL=0
MAX_OPEN_POSITIONS=5
STOP_LOSS_PCT=40
DAILY_LOSS_LIMIT_USD=75

# ---- Alerts (optional) ----
# Discord: channel settings > Integrations > Webhooks > New Webhook > Copy Webhook URL
DISCORD_WEBHOOK_URL=
# What gets sent (so 20+ wallets never means a ping per trade):
#  instantly: executor position closed (paper or live), real-money fills, a wallet promoted to / demoted
#             from live, message budget hit, kill switch / daily loss limit, errors (deduped)
#  roll-up:   a net summary of paper copies at ALERT_SIM_DELAY every ALERT_ROLLUP_EVERY (0 = off):
#             period net, win rate, best and worst copy, today's running total, top/bottom wallet;
#             skipped when nothing closed
#  digest:    daily summary at ALERT_DIGEST_HOUR (local, -1 = off): best/worst wallets, drops, discoveries, spend
ALERT_SIM_DELAY=2
ALERT_ROLLUP_EVERY=1h
ALERT_DIGEST_HOUR=9
ALERT_TZ=America/Toronto
ALERT_MAX_PER_HOUR=10
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
